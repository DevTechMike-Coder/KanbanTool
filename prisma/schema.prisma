// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth Features
model Profile {
  id                  String           @id
  email               String           @unique
  name                String?
  bio                 String?
  avatarUrl           String?
  lastActiveAt        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tasks               Task[]           @relation("TaskAssignee")
  createdTasks        Task[]           @relation("TaskCreator")
  messages            Message[]
  teams               Team[]           @relation("TeamMembers")
  createdTeams        Team[]           @relation("TeamCreator")
  comments            Comment[]
  attachments         Attachment[]
  receivedInvitations TeamInvitation[]
  notifications       Notification[]
}

model Project {
  id            String   @id @default(uuid())
  name          String
  summary       String?
  productGoal   String?
  workflowState String? // JSON string representing customized node details
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasks         Task[]
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Task {
  id           String       @id @default(uuid())
  title        String
  column       String // backlog, todo, in-progress, review, completed
  priority     String       @default("medium") // low, medium, high, critical
  dueDate      DateTime?
  comments     Int          @default(0)
  files        Int          @default(0)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     Profile?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId    String?
  creator      Profile?     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  labels       String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  commentsList Comment[]
  attachments  Attachment[]

  // Self-referencing many-to-many relation for task-to-task blockers
  dependencies Task[] @relation("TaskDependencies")
  blockedTasks Task[] @relation("TaskDependencies")

  @@index([projectId])
  @@index([assigneeId])
}

model Team {
  id          String           @id @default(uuid())
  name        String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creatorId   String?
  creator     Profile?         @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     Profile[]        @relation("TeamMembers")
  messages    Message[]
  projects    Project[]
  invitations TeamInvitation[]
}

model TeamInvitation {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   Profile  @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, inviteeId])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  senderId  String
  sender    Profile  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileSize  Int
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // task_assigned | task_comment | team_invite
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  // Denormalized for cheap reads — no joins needed in the feed
  projectId  String?
  projectName String?
  taskId     String?
  taskTitle  String?
  userId     String
  actorName  String?
  action     String   // task_created | task_moved | task_assigned | task_deleted | comment_added | project_created
  meta       String?  // JSON — action-specific context (e.g. { from: "todo", to: "in-progress" })
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
